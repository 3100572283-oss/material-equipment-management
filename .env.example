# 物资设备管理系统 - 环境变量配置示例
# 复制本文件为 .env 并填写真实值

# Flask 安全密钥（必填！生产环境务必使用随机长字符串）
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# 数据库配置（默认 SQLite，可选改为 MySQL/PostgreSQL）
# DATABASE_URL=mysql+pymysql://user:password@localhost/material_mgmt

# 上传文件目录（可选，默认使用项目内 uploads 目录）
# UPLOAD_FOLDER=/path/to/uploads

# 分页每页条数（可选，默认 10）
# ITEMS_PER_PAGE=10

# AI 功能配置（可选，不配置则禁用 AI 助手）
# AI_API_KEY=your-ai-api-key
# AI_MODEL=doubao-pro-32k

# 管理员初始密码（可选，默认 Admin@2024，部署后请立即修改）
# ADMIN_DEFAULT_PASSWORD=Admin@2024
